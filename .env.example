# Copy these values into your shell or IDE run configuration.
# Spring Boot does not load .env files automatically.
DB_URL=jdbc:mysql://localhost:3306/staylanka?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Colombo
DB_USERNAME=staylanka
DB_PASSWORD=replace-with-a-local-password
UPLOAD_DIR=./uploads

# Used only with the dev profile. Accounts are skipped when passwords are blank.
DEV_ADMIN_EMAIL=admin@staylanka.lk
DEV_ADMIN_PASSWORD=replace-with-a-strong-development-password
DEV_STAFF_EMAIL=staff@staylanka.lk
DEV_STAFF_PASSWORD=replace-with-a-strong-development-password
